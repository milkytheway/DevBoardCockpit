{
  "name": "devboard-cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "开发板驾驶舱 —— 面向嵌入式 Linux 开发者的 Windows 桌面工作台",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/clean-out.mjs && electron-vite build && tsx scripts/check-build.ts",
    "build:fake": "node scripts/clean-out.mjs && electron-vite build --mode fake",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cards": "npm run build && playwright test",
    "test:cards:fake": "npm run build:fake && playwright test",
    "validate:profiles": "tsx scripts/validate-profiles.ts",
    "probe:board": "tsx scripts/probe.ts",
    "workflow:run": "tsx scripts/run-workflow.ts",
    "workflow:list": "tsx scripts/workflow-registry.ts list",
    "workflow:approve": "tsx scripts/workflow-registry.ts approve",
    "workflow:revoke": "tsx scripts/workflow-registry.ts revoke",
    "gen:vocabulary": "tsx scripts/gen-vocabulary.ts",
    "gen:vocabulary:check": "tsx scripts/gen-vocabulary.ts --check",
    "gen:theme": "tsx scripts/gen-theme.ts",
    "gen:theme:check": "tsx scripts/gen-theme.ts --check",
    "mutation:check": "node scripts/mutation-check.mjs",
    "postinstall": "node scripts/ensure-native.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "js-yaml": "4.3.2",
    "node-pty": "1.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-layout": "1.4.4",
    "serialport": "13.0.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@electron/rebuild": "3.7.2",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.13.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/react-grid-layout": "1.3.5",
    "@types/ssh2": "1.15.1",
    "@typescript-eslint/eslint-plugin": "8.46.4",
    "@typescript-eslint/parser": "8.46.4",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "34.5.8",
    "electron-vite": "5.0.0",
    "eslint": "9.39.1",
    "happy-dom": "20.0.11",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "node-pty": false,
    "ssh2": false,
    "@serialport/bindings-cpp": false,
    "@playwright/test": false
  }
}
