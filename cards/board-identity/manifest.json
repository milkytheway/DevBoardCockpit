{
  "apiVersion": "devboard/v1",
  "kind": "Card",
  "id": "board-identity",
  "name": "板卡身份",
  "version": "3.0.0",
  "description": "板型号、调频策略与 GPU 频率；背光等控制项归控制面（M6）",
  "entry": "index.html",
  "requires": {
    "tags": ["board.model"]
  },
  "layout": { "w": 3, "h": 3, "min_w": 2, "min_h": 2 },
  "permissions": {
    "read": ["board.model", "cpu.governor", "gpu.freq_hz"],
    "write": []
  },
  "actions": []
}
