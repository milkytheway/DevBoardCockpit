# Dependencies
node_modules/

# Build output
dist/
out/
release/
*.asar

# Runtime data (logs, user profiles, scratch)
logs/
*.log
*.tmp

# ...but fixtures/ 里的是**黄金测试向量**，必须入库
# （fixtures/session-log/serial-session.log 曾被上面的 *.log 误伤，
#   导致它只存在于工作树、不在 git 里——评审时才发现）
!fixtures/**/*.log

# Local settings (machine-specific paths, do not commit)
profiles/settings.local.json

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Python leftovers from the predecessor project
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# 会话本地的状态文件（不是工程内容）
.claude/ralph-loop.local.md

# 本地临时脚本（原生模块 prebuild 自检用）
/prebuild-*.cjs

# superpowers 计划工作区（ledger / briefs / review package）
.superpowers/

# Scratch workspace for one-shot analysis scripts
.work/

# One-shot scripts and intermediate artefacts of the release cleanup
/.tmp-*.cjs
/.my-*.cjs
/.scan-*.cjs
/.scan-*.json
/.prot.txt
/.stage-test.txt

# 平台专属原生包的备份（共享 node_modules 的固有代价）
.cache/

# 变异测试的还原日志（进程被 SIGKILL 时靠它还原）
.mutation-restore.json

# Playwright 产物（npm run test:cards 会生成）
test-results/
playwright-report/

# 审查看图的产物（一次性截图 ✓ —— 不进版本库 ✓）
shots/
