# Dependencies
node_modules/

# Build output
dist/
out/
release/
*.asar

# Runtime data (logs, user profiles, scratch)
logs/
*.log
*.tmp

# ...but the files under fixtures/ are golden test vectors and must be tracked.
# (fixtures/session-log/serial-session.log was caught by the *.log rule above,
#   so it existed only in the working tree and not in git. It was noticed
#   during a review.)
!fixtures/**/*.log

# Local settings (machine-specific paths, do not commit)
profiles/settings.local.json

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Python leftovers from the predecessor project
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Session-local state (not part of the project)
.claude/ralph-loop.local.md

# Local helper scripts for the native module prebuild self-check
/prebuild-*.cjs

# The superpowers planning workspace (ledger / briefs / review package)
.superpowers/

# Scratch workspace for one-shot analysis scripts
.work*/

# One-shot scripts and intermediate artefacts of the release cleanup
/.tmp-*
/.my-*
/.scan*
/.fix-*
/.patch-*
/.prot.txt
/.stage-test.txt
/.zh-ranges.txt
/.linkcheck.cjs

# Backup of the platform-specific native packages (the price of a shared node_modules)
.cache/

# The restore log of the mutation test (it restores the sources when the process is killed)
.mutation-restore.json

# Playwright artefacts (npm run test:cards writes them)
test-results/
playwright-report/

# Screenshots taken while reviewing (one-off, not part of the project)
shots/